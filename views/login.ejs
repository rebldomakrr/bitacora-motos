<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Bitácora de Motos</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .card { background: #1e293b; padding: 2rem; border-radius: 12px; width: 100%; max-width: 380px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); border: 1px solid #334155; }
    h2 { margin-top: 0; color: #38bdf8; text-align: center; }
    label { display: block; margin: 1rem 0 0.25rem; font-size: 0.875rem; color: #94a3b8; }
    input { width: 100%; padding: 0.75rem; border: 1px solid #334155; background: #0f172a; border-radius: 6px; color: #fff; box-sizing: border-box; }
    button { width: 100%; margin-top: 1.5rem; padding: 0.75rem; background: #0284c7; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; transition: background 0.2s; }
    button:hover { background: #0369a1; }
    .error { background: #ef444420; color: #f87171; padding: 0.5rem; border-radius: 6px; margin-bottom: 1rem; border: 1px solid #ef444450; font-size: 0.875rem; text-align: center; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Iniciar Sesión</h2>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form action="/login" method="POST">
      <label>Correo Electrónico</label>
      <input type="email" name="email" required placeholder="admin@taller.com">
      <label>Contraseña</label>
      <input type="password" name="password" required placeholder="••••••••">
      <button type="submit">Ingresar al Sistema</button>
    </form>
  </div>
</body>
</html>